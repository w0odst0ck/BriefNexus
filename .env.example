# Copy to .env and adjust as needed.
# All values are optional — defaults work out of the box.

# Listen address (container deployments must use 0.0.0.0)
# BN_HOST=0.0.0.0
# BN_PORT=9000

# Allow inline code collectors (POST /v1/collect with collector.code)
# Disabled by default; enabling exposes server to arbitrary code execution.
# ALLOW_INLINE_CODE=false